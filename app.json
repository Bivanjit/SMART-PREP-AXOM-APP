{
  "expo": {
    "name": "SmartPrep Axom",
    "slug": "smartprep-axom",
    "scheme": "smartprepaxom",
    "version": "3.5.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06163B"
    },
    "android": {
      "package": "com.smartprepaxom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06163B"
      },
      "versionCode": 35400,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#06163B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "description": "SmartPrep Axom Assam CEE preparation app — version 3.5.4"
  }
}
