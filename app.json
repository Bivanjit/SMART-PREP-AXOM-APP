{
  "expo": {
    "name": "SmartPrep Axom",
    "slug": "smartprep-axom",
    "scheme": "smartprepaxom",
    "version": "3.5.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06163B"
    },
    "android": {
      "package": "com.smartprepaxom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06163B"
      },
      "versionCode": 35200
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#06163B"
        }
      ],
      "expo-notifications"
    ],
    "icon": "./assets/icon.png"
  }
}
