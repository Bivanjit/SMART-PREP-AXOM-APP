{
  "expo": {
    "name": "SmartPrep Axom",
    "slug": "smartprep-axom",
    "scheme": "smartprepaxom",
    "version": "2.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "backgroundColor": "#0B1220"
      }
    },
    "android": {
      "package": "com.smartprepaxom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png"
  }
}
