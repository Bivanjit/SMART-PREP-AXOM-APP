{
  "expo": {
    "name": "SmartPrep Axom",
    "slug": "smartprep-axom",
    "scheme": "smartprepaxom",
    "version": "5.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-original.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.smartprepaxom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-original.png",
        "backgroundColor": "#01194E"
      },
      "versionCode": 51000,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-original.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ]
    ],
    "icon": "./assets/logo-original.png",
    "description": "SmartPrep Axom Assam CEE preparation app — version 5.1.0"
  }
}
